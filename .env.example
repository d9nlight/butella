# ==============================================================================
# BUTELLA Boutique — Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development.
# Fill in real values from Supabase, Telegram BotFather, and store details.

# ------------------------------------------------------------------------------
# 1. STORE & GENERAL CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=BUTELLA
NEXT_PUBLIC_STORE_LOCATION="г. Кызылорда, ул. Абая 45 (Бутик BUTELLA)"
NEXT_PUBLIC_STORE_PHONE="+7 (777) 123-45-67"
NEXT_PUBLIC_STORE_INSTAGRAM="https://instagram.com/butella_kz"
NEXT_PUBLIC_STORE_WHATSAPP="https://wa.me/77771234567"

# Delivery prices in Kazakhstan Tenge (KZT)
NEXT_PUBLIC_SHIPPING_PICKUP_PRICE=0
NEXT_PUBLIC_SHIPPING_LOCAL_PRICE=1500
NEXT_PUBLIC_SHIPPING_KAZAKHSTAN_PRICE=2500

# ------------------------------------------------------------------------------
# 2. SUPABASE (Database, Auth, and Image Storage)
# Obtain these from your Supabase Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
# Secret server-side key - NEVER expose in client code
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT NOTIFICATIONS
# ------------------------------------------------------------------------------
# Obtain token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Obtain your numeric chat ID by messaging @userinfobot on Telegram
TELEGRAM_OWNER_CHAT_ID=123456789
# Random secret token to verify incoming webhook requests from Telegram
TELEGRAM_WEBHOOK_SECRET=generate_a_random_secure_secret_token_here

# ------------------------------------------------------------------------------
# 4. KASPI PAY DETAILS
# ------------------------------------------------------------------------------
# Phone number or merchant identifier shown to customers during Kaspi checkout
NEXT_PUBLIC_KASPI_PHONE="+7 (777) 123-45-67"
NEXT_PUBLIC_KASPI_RECIPIENT_NAME="BUTELLA BOUTIQUE"
# Kaspi Pay direct transfer / bill link or QR identifier (if configured)
NEXT_PUBLIC_KASPI_PAY_LINK="https://kaspi.kz/pay/butella"
